{
  "name": "pandocit",
  "version": "2.0.65",
  "description": "Citations Pandoc, bibliothèque Zotero (API), lecteurs PDF/EPUB et annotations pour Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "check-types": "tsc --noemit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --write \"./src/**/*.{ts,tsx}\"",
    "clean": "yarn prettier && yarn lint:fix",
    "test": "jest",
    "rlnotes": "git log $(git describe --tags --abbrev=0)..HEAD --oneline > release-notes.md && git add release-notes.md",
    "bump": "node version-bump.mjs && git add package.json manifest.json versions.json && yarn rlnotes",
    "release": "git commit -m $npm_package_version && git tag $npm_package_version && git push && git push --tags"
  },
  "keywords": [],
  "author": "l'Atelier",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=18",
    "yarn": "1.22.x"
  },
  "packageManager": "yarn@1.22.22",
  "resolutions": {
    "cross-spawn": "7.0.6",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/common": "1.5.3"
  },
  "devDependencies": {
    "@babel/core": "7.17.9",
    "@babel/preset-env": "7.16.11",
    "@babel/preset-typescript": "7.16.7",
    "@codemirror/language": "6.12.3",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@eslint/js": "^9.39.0",
    "@lezer/common": "1.5.3",
    "@types/jest": "27.4.1",
    "@types/lru-cache": "7.6.1",
    "@types/node": "16.11.6",
    "@types/react-dom": "18.2.6",
    "babel-jest": "27.5.1",
    "cross-env": "7.0.3",
    "eslint": "^9.39.0",
    "eslint-plugin-obsidianmd": "^0.5.0",
    "globals": "^17.14.0",
    "jest": "27.5.1",
    "obsidian": "^1.14.4",
    "tslib": "2.3.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "xml-js": "1.6.11"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "0.3.0",
    "citeproc": "2.4.63",
    "esbuild": "0.25.12",
    "fast-deep-equal": "3.1.3",
    "fflate": "0.8.3",
    "foliate-js": "1.0.1",
    "fuse.js": "6.6.2",
    "lru-cache": "7.8.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.4.299",
    "preact": "10.16.0",
    "react": "npm:@preact/compat",
    "react-dom": "npm:@preact/compat",
    "text-clipper": "^2.2.0"
  },
  "jest": {
    "transformIgnorePatterns": [],
    "testEnvironment": "jsdom",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^obsidian$": "<rootDir>/__mocks__/obsidian.js"
    }
  }
}
