        pdfViewer.currentScaleValue = 'page-fit';
      });
    })().catch((e) => {
      console.error('[PandoCit PDF inline viewer]', e);
      document.body.innerHTML = '<pre style="padding:12px;color:#c00">PDF viewer failed: ' + (e?.message || e) + '</pre>';
    });
  <\/script>
